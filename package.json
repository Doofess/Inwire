{
  "name": "inwire",
  "private": true,
  "version": "0.5.0",
  "description": "Real-time network packet analyzer for the desktop, with its capture agent built in.",
  "license": "MIT",
  "author": "Rotem Grinhut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doofess/Inwire.git"
  },
  "bugs": {
    "url": "https://github.com/Doofess/Inwire/issues"
  },
  "homepage": "https://github.com/Doofess/Inwire#readme",
  "keywords": [
    "packet-analyzer",
    "protocol-analyzer",
    "network",
    "pcap",
    "pcapng",
    "npcap",
    "electron",
    "wireshark"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node electron/dev.cjs",
    "build": "vite build && npm run build:electron",
    "build:electron": "node electron/build.cjs",
    "start:app": "npm run build && node electron/start.cjs",
    "pack": "npm run build && electron-builder --dir",
    "build:agent": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent/build-rust.ps1",
    "dist:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign/build-signed.ps1",
    "lint": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "sync:version": "tsx scripts/agent/sync-version.ts",
    "check": "npm run lint && tsx scripts/check.ts",
    "clean": "node -e \"for (const d of ['dist','dist-electron','release','build','installer/output','local-agent/build','local-agent/dist','local-agent/installer/output','agent-rs/dist']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "^6.5.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "resedit": "3.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
