{
  "name": "inwire",
  "private": true,
  "version": "0.0.0",
  "description": "Real-time network packet analyzer for the desktop, with its capture agent built in.",
  "license": "MIT",
  "author": "Rotem Grinhut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doofess/Inwire.git"
  },
  "bugs": {
    "url": "https://github.com/Doofess/Inwire/issues"
  },
  "homepage": "https://github.com/Doofess/Inwire#readme",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node electron/dev.cjs",
    "dev:web": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build && npm run build:electron",
    "build:electron": "node electron/build.cjs",
    "start:app": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "lint": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "check": "npm run lint && tsx scripts/check.ts",
    "clean": "node -e \"for (const d of ['dist','dist-electron','release']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "maplibre-gl": "^6.5.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  }
}
