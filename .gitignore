node_modules/
build/
dist/
# The compiled main process, and electron-builder's output. `release/`
# rather than the default `dist/`, which is Vite's.
dist-electron/
release/
coverage/
.DS_Store
*.log
.env*

# Compiled local-agent build artifacts (~19-21MB Windows binaries). Regenerate
# rather than tracking them:
#   pyinstaller local-agent/inwire_agent.spec  -> local-agent/dist/ (ignored by dist/ above)
#   npm run pack                                -> release/win-unpacked/
#   iscc installer/setup.iss                    -> installer/output/Inwire-Setup.exe
#
# The Unix tarball goes to release-artifacts/, which is NOT under public/:
# Vite copies public/** into dist/ verbatim, so an artifact left there is
# packaged inside the desktop app. `release/` does not match it - the comment
# above assumed it did, and the next --build run put a tarball in `git status`.
installer/output/
local-agent/installer/output/
release-artifacts/
public/downloads/

# `proc/self/fd/1` is not a directory Windows has. Under Git Bash a redirect to
# /proc/self/fd/1 makes MSYS create a real file at that path instead of writing
# to stdout, and one was committed that way. Ignored so it cannot come back.
proc/

# Python bytecode cache
__pycache__/
*.pyc

# Session planning artifacts written by coding agents. Kept on disk as a record
# of how a change was arrived at, but they are scratch, not project docs, and
# they go stale the moment the code moves past them.
docs/superpowers/
.superpowers/
# Agent web-research dumps. They describe the owner's own network, so an ADR
# restates what it relies on and cites the primary sources instead.
exa-results/
scripts/brand/.raster.html

# Parity fixtures: real captures with personal names and addresses inside (docs/decisions/0004).
# The README and acceptance.json in that directory are the only tracked files.
test/fixtures/*
!test/fixtures/README.md
!test/fixtures/acceptance.json
# Loose real captures and the app's own exports of them, kept beside the fixtures for
# testing by hand - the same personal traffic, so the same rule.
/test/*.pcap
/test/*.pcapng
/test/*.xlsx
/test/*.csv
/test/*.json
/test/*.pdf
*.tmp

# The Rust agent's build output, and the stamped exe the installer ships
# (`npm run build:agent` -> agent-rs/dist/inwire-agent-windows.exe).
agent-rs/target/
agent-rs/dist/
# A second target directory, for building while something is running the exe
# out of target/ (CARGO_TARGET_DIR=agent-rs/target-fix).
agent-rs/target-fix/

# Which code-signing certificate THIS machine signs with (scripts/sign/sign.ps1).
# A thumbprint names a certificate in one account's store on one PC, so it is
# configuration, not source - and the day a real certificate replaces the
# self-signed one, the build must not change. Certificates themselves never
# belong here either; scripts/sign/signing.ts fails on a tracked .cer/.pfx.
.signing.json
# Claude Code: per-machine settings and the worktrees its sessions create.
# The shared project setup is .claude/settings.json; see .claude/README.md.
.claude/settings.local.json
.claude/worktrees/
